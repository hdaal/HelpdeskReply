{
  "manifest_version": 2,
  "name": "Helpdesk Reply",
  "version": "1.6.28",
  "description": "Organize respostas prontas em abas, marque uma favorita e insira textos com rapidez.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-reply@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "32": "icons/helpdesk-reply.svg",
    "48": "icons/helpdesk-reply.svg",
    "96": "icons/helpdesk-reply.svg"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "webNavigation",
    "storage",
    "clipboardWrite",
    "<all_urls>"
  ],
  "background": { "scripts": ["background.js"] },
  "browser_action": {
    "default_title": "Abrir Helpdesk Reply",
    "default_icon": "icons/helpdesk-reply.svg"
  },
  "sidebar_action": {
    "default_title": "Helpdesk Reply",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/helpdesk-reply.svg",
    "open_at_install": true
  },
  "commands": {
    "toggle-helpdesk-reply": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Abrir ou fechar o painel lateral do Helpdesk Reply"
    }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content/page-helper.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
